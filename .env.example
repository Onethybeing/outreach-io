# Postgres (Neon primary; swap for GCP Cloud SQL URL in prod)
DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require

# LLM / search / enrichment
GROQ_API_KEY=
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
APOLLO_API_KEY=
BRIGHTDATA_API_KEY=

# Gmail (OAuth client for sending/reading mail)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_ADDRESS=

# Langfuse tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# App mode: dev never sends real email; prod requires explicit confirm in dashboard
APP_MODE=dev
