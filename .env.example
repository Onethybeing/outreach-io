# Postgres (Neon primary; swap for GCP Cloud SQL URL in prod)
DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require

# --- Bootstrap secrets: never stored in the vault (PLAN.md section 7) ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes every vault entry unreadable. Back it up (GCP Secret Manager in prod).
VAULT_MASTER_KEY=
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Becomes admin on startup only if there is no active admin.
INITIAL_ADMIN_EMAIL=
# Google OAuth Web client for dashboard login. Authorized redirect URI: {PUBLIC_BASE_URL}/auth/callback
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
PUBLIC_BASE_URL=http://localhost:8000
# Shared secret for Cloud Scheduler → POST /internal/poll-replies. Leave empty to disable.
INTERNAL_TASK_TOKEN=

# --- Provider keys: imported into the vault on first start, then manage them in Settings → Vault ---
GROQ_API_KEY=
TAVILY_API_KEY=
APOLLO_API_KEY=
BRIGHTDATA_API_KEY=

# Gmail sending account (run scripts/gmail_auth.py to get the refresh token)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_ADDRESS=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com

# App mode: dev never sends real email; prod requires explicit confirm in dashboard
APP_MODE=dev
